# --- Supabase (Project Settings -> API) ---
# Bare project URL only — no /rest/v1 suffix.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for `npm run templates:sync -- --push` (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy (docker compose) ---
# Your domain, without https:// — Caddy gets the TLS certificate for it.
DOMAIN=thiepcuoi.example.com

# --- Node server ---
PORT=3000
# Public origin used in og:url / og:image (e.g. https://thiepcuoi.example.com). Empty = from request headers.
SITE_URL=
# Optional: serve template assets (/templates/...) from a CDN / bucket instead of this server.
# Must also be set as VITE_ASSET_BASE_URL at build time so the admin shows the same URLs.
ASSET_BASE_URL=
VITE_ASSET_BASE_URL=
# Wedding dates typed in the editor carry no offset; this is the timezone they mean.
TEMPLATE_TIMEZONE=Asia/Ho_Chi_Minh
# Favicon for public invitation pages (path under public/).
SITE_FAVICON=/images/kane-monogram-400x400.png
