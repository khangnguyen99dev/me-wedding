{
    "name": "me-wedding-supabase",
    "private": true,
    "type": "module",
    "engines": { "node": ">=20.12" },
    "scripts": {
        "dev": "concurrently -k -n vite,server -c \"#c4b5fd,#93c5fd\" \"vite\" \"tsx watch server/index.ts\"",
        "build": "vite build && npm run build:server",
        "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
        "start": "NODE_ENV=production node dist-server/index.js",
        "type-check": "vue-tsc --noEmit -p tsconfig.json",
        "templates:sync": "tsx scripts/sync-templates.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.13.7",
        "@supabase/supabase-js": "^2.47.10",
        "hono": "^4.6.14",
        "pinia": "^2.3.0",
        "sortablejs": "^1.15.6",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.10.0",
        "@types/sortablejs": "^1.15.8",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/tsconfig": "^0.7.0",
        "concurrently": "^9.0.1",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^7.0.7",
        "vue-tsc": "^2.2.0"
    }
}
