{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@shared/*": ["shared/*"]
        },
        "types": ["vite/client", "node"],
        "noImplicitAny": false,
        "strict": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "shared/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "vite.config.ts"],
    "exclude": ["node_modules", "dist", "dist-server"]
}
